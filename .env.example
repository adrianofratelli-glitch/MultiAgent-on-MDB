MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=multi_agent_poc
MONGODB_BRAIN_DB=multiagent_brain
ANTHROPIC_API_KEY=
JWT_SECRET=troque-por-um-segredo-com-32-caracteres
JWT_TTL_MINUTES=60
AUTH_REQUIRED=1
# Desabilite fora do roteiro local; autenticação real deve emitir os JWTs.
DEMO_TOKEN_ISSUANCE_ENABLED=1
# Em qualquer ambiente não local: ENVIRONMENT=production e DEMO_TOKEN_ISSUANCE_ENABLED=0.
ENVIRONMENT=development
ADMIN_API_KEY=troque-a-chave-administrativa
GLOBAL_TURN_TOKEN_BUDGET=20000
TURN_DEADLINE_SECONDS=120
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LOG_JSON=1
DEMO_MODE=0
CORS_ORIGINS=http://127.0.0.1:5191
API_HOST=127.0.0.1
API_PORT=8031
FRONTEND_PORT=5191
SHORT_TERM_CACHE_THRESHOLD=0.80
GLOBAL_CACHE_THRESHOLD=0.83
LONG_TERM_MEMORY_LIMIT=5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Grove: cole somente a chave no campo abaixo (não no chat).
GROVE_API_KEY=
GROVE_ANTHROPIC_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic
# URL COMPLETA Chat Completions e aliases fornecidos pelo Grove; deixar vazio até confirmar.
GROVE_CHAT_COMPLETIONS_URL=
GROVE_OPENAI_MODELS=[]
# USD por milhão: campos input_tokens, output_tokens, cache_read_tokens, cache_write_tokens por modelo.
# Tarifas ausentes são exibidas como custo não disponível.
LLM_PRICES={}
# Médias observadas por modelo no Grove, captura de 19/09/2026; não são tarifas contratuais.
LLM_BLENDED_PRICES={"claude-haiku-4-5":2.40,"gpt-5.6-luna":0.38}

# Aquecimento automático do cache semântico (ao subir o backend e quando o frontend abre). 0 desliga.
WARMUP_ON_START=1
WARMUP_COOLDOWN_MINUTES=45
# Nome do app nos logs/conexão do Mongo e, opcionalmente, endpoint direto da Anthropic (vazio = padrão).
APP_NAME=multi-agent-poc
ANTHROPIC_BASE_URL=
